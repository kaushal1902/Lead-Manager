datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  New
  Contacted
  Qualified
  Lost
}

enum LeadSource {
  Website
  Referral
  LinkedIn
  Cold_Outreach @map("Cold Outreach")
  Other
}

model Lead {
  id        String      @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  source    LeadSource  @default(Website)
  status    LeadStatus  @default(New)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([email])
  @@index([status])
  @@index([name])
  @@index([createdAt])
}
