datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  New
  Contacted
  Qualified
  Lost
}

enum LeadSource {
  Website
  Referral
  LinkedIn
  Cold_Outreach @map("Cold Outreach")
  Other
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Lead {
  id        String      @id @default(uuid())
  name      String
  email     String
  phone     String?
  company   String?
  source    LeadSource  @default(Website)
  status    LeadStatus  @default(New)
  notes     String?

  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([email])
  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@index([userId])
}
